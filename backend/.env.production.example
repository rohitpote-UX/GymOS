# -----------------------------------------------------------------------------
# GYM BUSINESS OS — PRODUCTION ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
APP_NAME="Gym Business OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://api.yourgymdomain.com

LOG_CHANNEL=daily
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL 8 Production)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gym_business_os
DB_USERNAME=gym_production_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# -----------------------------------------------------------------------------
# SESSION & CACHE CONFIGURATION
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# SANCTUM & CORS
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=app.yourgymdomain.com,yourgymdomain.com
FRONTEND_URL=https://app.yourgymdomain.com

# -----------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (Live Production Keys)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_SECURE_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# META WHATSAPP BUSINESS CLOUD API
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
WHATSAPP_TOKEN=YOUR_SYSTEM_USER_PERMANENT_ACCESS_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=YOUR_CUSTOM_VERIFY_SECRET_TOKEN

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI BUSINESS ADVISOR
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_YOUR_LIVE_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
